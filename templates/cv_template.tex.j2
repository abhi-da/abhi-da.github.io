\newcommand{\cvitem}[3]{%
  \noindent\textbf{#1} \hfill {\color{muted}#2}\\
  #3\par\vspace{0.55em}
}

\begin{document}

\begin{center}
  {\Huge\bfseries\color{accent} (((name)))}\\[0.3em]
